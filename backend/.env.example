DATABASE_URL=postgresql+psycopg2://spetion:spetion@localhost:5432/spetion_exam
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=spetion
S3_SECRET_KEY=spetion123
S3_BUCKET=exam-uploads

# STORAGE_BACKEND=local uses plain disk (LOCAL_STORAGE_DIR) instead of S3 —
# only for developing without Docker/MinIO running. Leave unset (defaults
# to "s3") once docker-compose's MinIO is up.
# STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=./local_storage

# CELERY_EAGER=true runs parsing synchronously in-process instead of via a
# worker — only for developing without Docker/Redis running.
# CELERY_EAGER=true

# TESSERACT_CMD: only set this if `tesseract --version` doesn't work from a
# plain shell (e.g. right after a fresh Windows install, before restarting
# your terminal/IDE so PATH picks it up). Point it at the full path to the
# binary, e.g. on Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=

# ANTHROPIC_API_KEY: required for AI-graded short-answer questions
# (ai_grading_service.py) — get one at console.anthropic.com. Left unset,
# grading falls back to 0 points + an explanatory message instead of
# crashing, so this is safe to leave empty until you're ready.
# ANTHROPIC_API_KEY=
